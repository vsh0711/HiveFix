# LLM
ANTHROPIC_API_KEY=

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hivefix

# GitHub
GITHUB_TOKEN=
# owner/repo of THIS project — used to dispatch the sandbox-test.yml workflow
HIVEFIX_REPO=your-github-username/hivefix

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hivefix_code_chunks

# Orchestrator
MAX_PATCH_ATTEMPTS=2
SANDBOX_POLL_INTERVAL_SECONDS=10
SANDBOX_POLL_TIMEOUT_SECONDS=900
