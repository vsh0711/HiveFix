# LLM (Groq free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hivefix

# GitHub
GITHUB_TOKEN=
# owner/repo of THIS project — used to dispatch the sandbox-test.yml workflow
HIVEFIX_REPO=your-github-username/hivefix

# Required for any deployment reachable from the internet — gates POST /runs so
# strangers can't spend your Groq/GitHub quota. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank for local dev only; GET endpoints stay open either way.
HIVEFIX_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hivefix_code_chunks

# Orchestrator
MAX_PATCH_ATTEMPTS=3
SANDBOX_POLL_INTERVAL_SECONDS=10
SANDBOX_POLL_TIMEOUT_SECONDS=900
